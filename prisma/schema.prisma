generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  SIN_DOCUMENTOS
  DOCUMENTOS_SUBIDOS
  DOCUMENTOS_INCOMPLETOS
  PENDIENTE_REVISAR
  EN_REVISION
  OBSERVADO
  RETENIDO_USE
  PREPARACION
  ENVIADO_SPONSOR
  OBSERVADO_SPONSOR
  RECHAZADO_SPONSOR
  APROBADO_SPONSOR
  DS2019_EMITIDO
  RETIRADO
  ACTIVO
  INACTIVO

  @@map("user_status")
}

enum ProcesoEstado {
  EN_PROCESO
  FINALIZADO

  @@map("proceso_estado")
}

enum TypeDocument {
  DOCUMENT
  INFORMATIVE
}

enum TypeHired {
  HIRED
  NOT_HIRED
  ALL
}

enum DocumentSponsorStatus {
  PENDIENTE
  SUBIDO
  EN_REVISION
  OBSERVADO
  REVISADO
}

enum EmailTemplateType {
  NORMAL
  PROGRAMADA

  @@map("email_template_type")
}

model Country {
  id          String   @id @default(uuid())
  idExterno   String?
  code        String   @unique
  name        String
  currency    String?
  countryCode String?
  status      Boolean  @default(true)
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt

  users                               User[]
  documentProgramDescriptionCountries DocumentProgramDescriptionCountry[]
  procesos                            Proceso[]
}

model Program {
  id        String   @id @default(uuid())
  idExterno String?
  code      String   @unique
  name      String
  status    Boolean  @default(true)
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt

  users            User[]
  optionPrograms   OptionProgram[]
  documentPrograms DocumentProgram[]
  temporadas       Temporada[]
  procesos         Proceso[]
}

model Sponsor {
  id        String   @id @default(uuid())
  idExterno String?
  code      String   @unique
  name      String
  status    Boolean  @default(true)
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt

  users            User[]
  documentSponsors DocumentSponsor[]
  procesos         Proceso[]
}

model OptionProgram {
  id            String   @id @default(uuid())
  shortDatabase String
  programId     String
  status        Boolean  @default(true)
  createAt      DateTime @default(now())
  updateAt      DateTime @updatedAt

  program Program? @relation(fields: [programId], references: [id])

  users User[]

  procesos Proceso[]

  @@unique([programId, shortDatabase])
}

model Temporada {
  id        String   @id @default(uuid())
  programId String
  name      String
  status    Boolean  @default(true)
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt

  program          Program           @relation(fields: [programId], references: [id])
  documentPrograms DocumentProgram[]
  procesos         Proceso[]

  @@index([programId])
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  code        String?  @unique @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]
}

model Person {
  id             String  @id @default(uuid()) @db.VarChar(36)
  firstname      String
  middlename     String?
  lastfathername String
  lastmothername String?
  birthdate      String?
  phone          String? @db.VarChar(20)
  avatar         String? @db.VarChar(500)
  dni            String? @unique @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

/**
 * Una participación del alumno en un ciclo. Todo el expediente documental cuelga de aquí y no
 * de la persona: cuando alguien vuelve, se abre un proceso nuevo y el anterior queda intacto,
 * en vez de pisar la misma fila y heredar los archivos del año pasado.
 * Nota sobre los tipos: `participante_id` y `finalizado_by_id` son VarChar(36) porque User.id
 * lo es, pero programa, opción, sponsor, país y temporada NO lo son — esos modelos usan el
 * String por defecto de Prisma (VARCHAR(191)). MariaDB exige que la clave foránea coincida
 * exactamente con la columna referenciada, así que la diferencia es obligatoria.
 */
model Proceso {
  id              String  @id @default(uuid()) @db.VarChar(36)
  participanteId  String  @map("participante_id") @db.VarChar(36)
  programId       String  @map("program_id")
  optionProgramId String  @map("option_program_id")
  sponsorId       String? @map("sponsor_id")
  countryId       String  @map("country_id")
  temporadaId     String? @map("temporada_id")

  fechaIngreso     DateTime      @default(now()) @map("fecha_ingreso")
  estado           ProcesoEstado @default(EN_PROCESO)
  statusDocumental UserStatus    @default(SIN_DOCUMENTOS) @map("status_documental")

  /// Espejo de `estado` que existe solo para la restricción de abajo: true mientras el proceso
  /// está EN_PROCESO y NULL cuando se finaliza — nunca false. Como en MySQL los NULL no
  /// colisionan en un índice único, la base admite N procesos finalizados y como mucho uno
  /// abierto. No se escribe a mano en ningún lado: lo mantiene el repositorio junto con `estado`.
  activo Boolean?

  finalizadoAt   DateTime? @map("finalizado_at")
  finalizadoById String?   @map("finalizado_by_id") @db.VarChar(36)
  crmProcesoId   String?   @map("crm_proceso_id") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  userDocuments     UserDocuments[]
  userObservations  UserObservations[]
  vistoPor          User[]             @relation("UserProcesoVisible")

  participante  User          @relation("ProcesoParticipante", fields: [participanteId], references: [id])
  finalizadoBy  User?         @relation("ProcesoFinalizadoBy", fields: [finalizadoById], references: [id], onDelete: Restrict)
  program       Program       @relation(fields: [programId], references: [id])
  optionProgram OptionProgram @relation(fields: [optionProgramId], references: [id])
  sponsor       Sponsor?      @relation(fields: [sponsorId], references: [id], onDelete: Restrict)
  country       Country       @relation(fields: [countryId], references: [id])
  temporada     Temporada?    @relation(fields: [temporadaId], references: [id], onDelete: Restrict)

  // Máximo un proceso abierto por participante. MariaDB no soporta índices únicos parciales;
  // esto se apoya en que los NULL no colisionan (ver `activo`).
  @@unique([participanteId, activo], map: "uq_proceso_activo")
  @@index([participanteId, fechaIngreso], map: "idx_procesos_participante")
  @@index([estado], map: "idx_procesos_estado")
  @@map("procesos")
}

model User {
  id                    String     @id @default(uuid()) @db.VarChar(36)
  username              String?
  password              String?
  email                 String?
  roleId                String     @map("role_id") @db.VarChar(36)
  countryId             String?
  sponsorId             String?
  programId             String?
  optionProgramId       String?
  employer              String?
  status_hired          Int?
  hired_date            String?
  jo_use_date           String?
  programAgreementOK    Boolean?
  fechadeenvioalsponsor String?
  fechaDSinUSE          String?
  statusSolRetiro       String?
  statusExternal        String?
  status                UserStatus @default(ACTIVO)

  /// Proceso que el participante ve: el que tiene abierto y, si no tiene ninguno abierto, el más
  /// reciente. Nunca ve los anteriores. Es un puntero desnormalizado a propósito — los listados,
  /// exports y el embudo lo necesitan para acotar el expediente sin una subconsulta por fila.
  /// Lo escribe el repositorio de proceso en los tres momentos en que puede cambiar: al abrir uno,
  /// al finalizarlo y al reabrirlo. `null` para el staff de USE, que no tiene procesos.
  procesoVisibleId      String?    @map("proceso_visible_id") @db.VarChar(36)

  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  role           Role     @relation(fields: [roleId], references: [id])
  procesoVisible Proceso? @relation("UserProcesoVisible", fields: [procesoVisibleId], references: [id], onDelete: Restrict)
  country       Country?       @relation(fields: [countryId], references: [id])
  sponsor       Sponsor?       @relation(fields: [sponsorId], references: [id])
  program       Program?       @relation(fields: [programId], references: [id])
  optionProgram OptionProgram? @relation(fields: [optionProgramId], references: [id])

  documentsCreated        Documents[]       @relation("DocumentsCreatedBy")
  procesos                Proceso[]         @relation("ProcesoParticipante")
  procesosFinalizados     Proceso[]         @relation("ProcesoFinalizadoBy")
  documentsUpdated        Documents[]       @relation("DocumentsUpdatedBy")
  documentSponsorsCreated DocumentSponsor[] @relation("DocumentSponsorCreatedBy")
  documentSponsorsUpdated DocumentSponsor[] @relation("DocumentSponsorUpdatedBy")

  userDocuments         UserDocuments[]
  userDocumentHistories UserDocumentHistory[] @relation("UserDocumentHistoryCreatedBy")
  etiquetasCreated      Etiquetas[]           @relation("EtiquetasCreatedBy")
  etiquetasUpdated      Etiquetas[]           @relation("EtiquetasUpdatedBy")

  userObservations        UserObservations[]
  userObservationsCreated UserObservations[]  @relation("UserObservationsCreatedBy")
  userHistories           UserHistoryStatus[]

  emailTemplatesCreated EmailTemplate[] @relation("EmailTemplateCreatedBy")
  emailTemplatesUpdated EmailTemplate[] @relation("EmailTemplateUpdatedBy")
  emailLogs             EmailLog[]

  @@index([procesoVisibleId], map: "idx_user_proceso_visible")
}

model UserObservations {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String
  /// Ciclo en el que se levantó la observación. Es lo que impide que una observación abierta del
  /// ciclo anterior mande al participante a OBSERVADO en el ciclo nuevo, sin que haya subido nada:
  /// la regla de estado solo mira las del ciclo visible. Nullable porque el staff no tiene procesos.
  procesoId   String?   @map("proceso_id") @db.VarChar(36)
  observation String    @db.Text
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  endDate     DateTime?
  createdById String?   @map("created_by_id") @db.VarChar(36)

  users                    User                       @relation(fields: [userId], references: [id])
  proceso                  Proceso?                   @relation(fields: [procesoId], references: [id], onDelete: Restrict)
  createdBy                User?                      @relation("UserObservationsCreatedBy", fields: [createdById], references: [id])
  userObservationEtiquetas UserObservationEtiquetas[]
  userObservationFiles     UserObservationFiles[]

  @@index([procesoId], map: "idx_user_observations_proceso")
}

model UserObservationFiles {
  id                String   @id @default(uuid()) @db.VarChar(36)
  userObservationId String
  file              String   @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  userObservations UserObservations @relation(fields: [userObservationId], references: [id])
}

model UserObservationEtiquetas {
  id                String @id @default(uuid()) @db.VarChar(36)
  userObservationId String
  etiquetaId        String

  userObservations UserObservations @relation(fields: [userObservationId], references: [id])
  etiquetas        Etiquetas        @relation(fields: [etiquetaId], references: [id])
}

model UserHistoryStatus {
  id          String     @id @default(uuid()) @db.VarChar(36)
  userId      String
  status      UserStatus
  createdById String?    @map("created_by_id") @db.VarChar(36)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  users User @relation(fields: [userId], references: [id])
}

model Etiquetas {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id") @db.VarChar(36)
  updatedById String? @map("updated_by_id") @db.VarChar(36)

  createdBy User? @relation("EtiquetasCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("EtiquetasUpdatedBy", fields: [updatedById], references: [id])

  userDocumentHistoryEtiquetas UserDocumentHistoryEtiquetas[]
  userObservationEtiquetas     UserObservationEtiquetas[]
}

model Documents {
  id           String       @id @default(uuid()) @db.VarChar(36)
  name         String       @db.VarChar(200)
  type         TypeDocument
  formats      String?      @db.VarChar(500)
  showHired    TypeHired    @map("show_hired")
  title        String?
  order        Int?
  siglasCode   String?
  instructions String?      @db.Text
  required     Boolean      @default(false)
  status       Boolean      @default(true)
  createdById  String?      @map("created_by_id") @db.VarChar(36)
  updatedById  String?      @map("updated_by_id") @db.VarChar(36)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  createdBy        User?             @relation("DocumentsCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("DocumentsUpdatedBy", fields: [updatedById], references: [id])
  documentSponsors DocumentSponsor[]
  userDocuments    UserDocuments[]
  documentPrograms DocumentProgram[]

  @@index([type], map: "idx_documents_type")
  @@index([showHired], map: "idx_documents_show_hired")
  @@index([status], map: "idx_documents_status")
  @@index([createdById], map: "idx_documents_created_by")
  @@map("documents")
}

model DocumentSponsor {
  id          String   @id @default(uuid()) @db.VarChar(36)
  documentId  String   @map("document_id") @db.VarChar(36)
  sponsorId   String   @map("sponsor_id") @db.VarChar(36)
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdById String?  @map("created_by_id") @db.VarChar(36)
  updatedById String?  @map("updated_by_id") @db.VarChar(36)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  document  Documents @relation(fields: [documentId], references: [id])
  sponsor   Sponsor   @relation(fields: [sponsorId], references: [id])
  createdBy User?     @relation("DocumentSponsorCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("DocumentSponsorUpdatedBy", fields: [updatedById], references: [id])

  userDocuments UserDocuments[]

  @@unique([documentId, sponsorId], map: "uq_document_sponsor")
  @@index([documentId], map: "idx_document_sponsors_document")
  @@index([sponsorId], map: "idx_document_sponsors_sponsor")
  @@index([createdById], map: "idx_document_sponsors_created_by")
  @@map("document_sponsors")
}

model DocumentProgram {
  id          String   @id @default(uuid()) @db.VarChar(36)
  documentId  String   @map("document_id") @db.VarChar(36)
  programId   String   @map("program_id") @db.VarChar(36)
  // Dato informativo: NO participa en la regla de aplicabilidad del participante
  // (ver findApplicableForParticipant). El User todavia no tiene temporada asignada,
  // asi que no hay con que compararla. Sin tipo @db.VarChar(36) a proposito: debe
  // coincidir con Temporada.id, que es VARCHAR(191), o MariaDB rechaza la FK.
  temporadaId String?  @map("temporada_id")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  document             Documents                           @relation(fields: [documentId], references: [id])
  program              Program                             @relation(fields: [programId], references: [id])
  temporada            Temporada?                          @relation(fields: [temporadaId], references: [id], onDelete: Restrict)
  descriptions         DocumentProgramDescription[]
  descriptionCountries DocumentProgramDescriptionCountry[]

  @@unique([documentId, programId], map: "uq_document_program")
  @@index([documentId], map: "idx_document_programs_document")
  @@index([programId], map: "idx_document_programs_program")
  @@index([temporadaId], map: "idx_document_programs_temporada")
  @@map("document_programs")
}

model DocumentProgramDescription {
  id                String   @id @default(uuid()) @db.VarChar(36)
  documentProgramId String   @map("document_program_id") @db.VarChar(36)
  title             String   @db.VarChar(200)
  description       String   @db.Text
  order             Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  documentProgram DocumentProgram                     @relation(fields: [documentProgramId], references: [id])
  countries       DocumentProgramDescriptionCountry[]

  @@index([documentProgramId], map: "idx_document_program_descriptions_document_program")
  @@map("document_program_descriptions")
}

model DocumentProgramDescriptionCountry {
  id                           String   @id @default(uuid()) @db.VarChar(36)
  documentProgramDescriptionId String   @map("document_program_description_id") @db.VarChar(36)
  documentProgramId            String   @map("document_program_id") @db.VarChar(36)
  countryId                    String   @map("country_id") @db.VarChar(36)
  createdAt                    DateTime @default(now()) @map("created_at")

  documentProgramDescription DocumentProgramDescription @relation(fields: [documentProgramDescriptionId], references: [id])
  documentProgram            DocumentProgram            @relation(fields: [documentProgramId], references: [id])
  country                    Country                    @relation(fields: [countryId], references: [id])

  // Un país no puede pertenecer a dos grupos de descripción distintos bajo el mismo programa.
  @@unique([documentProgramId, countryId], map: "uq_document_program_country")
  @@index([documentProgramDescriptionId], map: "idx_dpd_countries_description")
  @@index([countryId], map: "idx_dpd_countries_country")
  @@map("document_program_description_countries")
}

model UserDocuments {
  id                String                @id @default(uuid()) @db.VarChar(36)
  documentSponsorId String?
  documentId        String?
  userId            String

  /// Proceso al que pertenece el documento. Obligatorio: un documento sin proceso no tendría
  /// dueño histórico, y el proceso es lo que permite que un ciclo finalizado quede congelado.
  /// Lo garantiza `EnsureProcesoInicial`, que el sync ejecuta antes de tocar el expediente: si al
  /// participante no se le puede abrir un proceso, no se le crean documentos.
  procesoId String @map("proceso_id") @db.VarChar(36)

  status            DocumentSponsorStatus
  statusDocument    Boolean               @default(true) @map("status_document")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  documentSponsors DocumentSponsor? @relation(fields: [documentSponsorId], references: [id])
  documents        Documents?       @relation(fields: [documentId], references: [id])
  users            User             @relation(fields: [userId], references: [id])
  proceso          Proceso          @relation(fields: [procesoId], references: [id], onDelete: Restrict)

  userDocumentHistory UserDocumentHistory[]

  @@index([procesoId], map: "idx_user_documents_proceso")
  // NO reintroducir un @@unique que incluya statusDocument en la clave. Se intentó
  // (20260730120000_add_user_documents_active_unique) para cerrar la condición de carrera del
  // sync, y rompía el guardado de documentos: con la clave (userId, documentId, statusDocument)
  // conviven un registro activo y uno histórico, pero en cuanto la aplicación desactiva el
  // activo quedan DOS filas históricas idénticas y el índice falla. Le pasa a cualquier
  // participante que ya tenga un histórico de ese documento — 104 casos al revertirlo.
  // Para volver a intentarlo hace falta un índice parcial "solo sobre los activos", que
  // MariaDB no tiene: se emula con una columna que valga 1 si está activo y NULL si no,
  // manteniéndola sincronizada en TODOS los puntos que tocan statusDocument.
}

model UserDocumentHistory {
  id              String                @id @default(uuid()) @db.VarChar(36)
  userDocumentsId String
  status          DocumentSponsorStatus
  url             String?               @db.Text
  observation     String?               @db.Text
  createdById     String?               @map("created_by_id") @db.VarChar(36)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  createdBy     User?         @relation("UserDocumentHistoryCreatedBy", fields: [createdById], references: [id])
  userDocuments UserDocuments @relation(fields: [userDocumentsId], references: [id])

  userDocumentHistoryEtiquetas UserDocumentHistoryEtiquetas[]
  userDocumentObservationFiles UserDocumentObservationFiles[]
}

model UserDocumentObservationFiles {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  userDocumentHistoryId String
  file                  String   @db.Text
  createdAt             DateTime @default(now()) @map("created_at")

  userDocumentHistory UserDocumentHistory @relation(fields: [userDocumentHistoryId], references: [id])
}

model UserDocumentHistoryEtiquetas {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  userDocumentHistoryId String   @db.VarChar(36)
  etiquetaId            String   @db.VarChar(36)
  createdAt             DateTime @default(now()) @map("created_at")

  userDocumentHistory UserDocumentHistory @relation(fields: [userDocumentHistoryId], references: [id])
  etiquetas           Etiquetas           @relation(fields: [etiquetaId], references: [id])
}

model EmailAction {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(50)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  emailTemplates EmailTemplate[]
  emailLogs      EmailLog[]

  @@index([status], map: "idx_email_actions_status")
  @@map("acciones_correo")
}

model EmailTemplate {
  id          String            @id @default(uuid()) @db.VarChar(36)
  name        String            @db.VarChar(100)
  code        String            @unique @db.VarChar(50)
  subject     String            @db.VarChar(150)
  htmlContent String            @map("html_content") @db.Text
  status      Boolean           @default(true)
  type        EmailTemplateType
  actionId    String            @map("action_id") @db.VarChar(36)
  schedule    Json?
  createdById String?           @map("created_by_id") @db.VarChar(36)
  updatedById String?           @map("updated_by_id") @db.VarChar(36)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  action    EmailAction @relation(fields: [actionId], references: [id])
  createdBy User?       @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy User?       @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id])
  emailLogs EmailLog[]

  @@index([actionId], map: "idx_email_templates_action")
  @@index([status], map: "idx_email_templates_status")
  @@index([type], map: "idx_email_templates_type")
  @@map("plantillas_correo")
}

enum EmailLogStatus {
  ENVIADO
  FALLIDO
  OMITIDO

  @@map("email_log_status")
}

// Historial de todo intento de envío de correo (normal o programado), exitoso o no.
// Los campos actionCode/templateCode/recipientEmail quedan como snapshot del momento del envío
// para que el historial siga siendo legible aunque luego se borre/edite la plantilla, la acción
// o cambie el email del usuario — las FKs son opcionales con onDelete SetNull por lo mismo.
model EmailLog {
  id              String            @id @default(uuid()) @db.VarChar(36)
  actionId        String?           @map("action_id") @db.VarChar(36)
  actionCode      String            @map("action_code") @db.VarChar(50)
  templateId      String?           @map("template_id") @db.VarChar(36)
  templateCode    String?           @map("template_code") @db.VarChar(50)
  recipientUserId String?           @map("recipient_user_id") @db.VarChar(36)
  recipientEmail  String?           @map("recipient_email") @db.VarChar(150)
  subject         String?           @db.VarChar(200)
  status          EmailLogStatus
  source          EmailTemplateType
  errorMessage    String?           @map("error_message") @db.Text
  sentAt          DateTime          @default(now()) @map("sent_at")

  action    EmailAction?   @relation(fields: [actionId], references: [id], onDelete: SetNull)
  template  EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipient User?          @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId], map: "idx_email_log_recipient")
  @@index([actionId], map: "idx_email_log_action")
  @@index([templateId], map: "idx_email_log_template")
  @@index([status], map: "idx_email_log_status")
  @@index([sentAt], map: "idx_email_log_sent_at")
  @@map("historial_correos")
}
